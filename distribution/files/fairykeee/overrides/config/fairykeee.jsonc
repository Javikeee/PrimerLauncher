  // ===== Grupos (party) =====
  // Jugadores por grupo (2–8). Un grupo junta a jugadores de cualquier gremio, o sin gremio.
  "party_max_size": 4,

  // Las invitaciones caducan (ticks; 1200 = 1 min).
  "party_invite_ticks": 1200,

  // Si los del mismo grupo pueden hacerse daño.
  "party_friendly_fire": false,

  // Distancia (bloques) a la que una criatura derrotada cuenta para las misiones de los compañeros de grupo y a la que se reparte la maestría.
  "party_share_radius": 48.0,

  // ===== Maestría =====
  // Nivel máximo de maestría mágica.
  "mastery_max_level": 30,

  // Experiencia para pasar del nivel 1 al 2; cada nivel pide mastery_xp_growth más que el anterior.
  "mastery_xp_base": 60,
  "mastery_xp_growth": 30,

  // Entrenamiento: maestría por cada habilidad lanzada (las limitan el enfriamiento y el Ethernano).
  "mastery_xp_per_cast": 3,

  // Maestría por cada monstruo derrotado con magia.
  "mastery_xp_per_magic_kill": 6,

  // Maestría por misión completada, por rango. Los compañeros de grupo cercanos reciben mastery_party_share.
  "mastery_xp_per_job": {
    "d": 25,
    "c": 50,
    "b": 100,
    "a": 180,
    "s": 350
  },
  "mastery_party_share": 0.5,

  // Por cada nivel por encima del 1: Ethernano máximo extra y poder de la magia (0.02 = +2 % de daño).
  "mastery_ethernano_per_level": 5,
  "mastery_power_per_level": 0.02,

  // ===== Técnicas secretas y misiones especiales =====
  // Nivel de maestría a partir del cual aparece en el tablón la misión especial de tu clase. Completarla enseña su técnica secreta (cuarta tecla, N).
  "secret_skill_level": 10,

